# Keep dhcpcd's prefix-delegation state in sync with interfaces(5).
# The WIDE variable names remain accepted while existing configurations migrate.
if [ "$PHASE" = "post-up" ] && [ "$ADDRFAM" = "inet6" ]
then
  if [ "$METHOD" = "manual" ] &&
      (grep -qx "$IFACE" /var/lib/iserv/config/ipv6-delegation-interfaces.list ||
       grep -qx "$IFACE" /var/lib/iserv/config/ipv6-dhcp-interfaces.list)
  then
    state_dir=/var/lib/iserv/config-ipv6/dhcpcd
    dhcpcd_ifid=${IF_DHCPCD_IFID:-${IF_WIDE_DHCPV6_IFID:-}}
    dhcpcd_sla_id=${IF_DHCPCD_SLA_ID:-${IF_WIDE_DHCPV6_SLA_ID:-}}
    dhcpcd_sla_len=${IF_DHCPCD_SLA_LEN:-${IF_WIDE_DHCPV6_SLA_LEN:-}}
    dhcpcd_request_na=${IF_DHCPCD_REQUEST_NA:-${IF_WIDE_DHCPV6_REQUEST_NA:-}}

    if [ -n "$dhcpcd_ifid$dhcpcd_sla_id$dhcpcd_sla_len$dhcpcd_request_na" ]
    then
      mkdir -p "$state_dir"
    fi

    for option in ifid sla-id sla-len request-na
    do
      eval value="\${dhcpcd_$(printf %s "$option" | tr - _)}"
      if [ -n "$value" ]
      then
        printf '%s\n' "$value" > "$state_dir/$IFACE.$option"
      else
        rm -f "$state_dir/$IFACE.$option"
      fi
    done

    iconf repair /etc/dhcpcd.conf || true
  fi

  mkdir -p /var/lib/iserv/config-ipv6/accept_ra
  ACCEPT_RA_MARKER_FILE="/var/lib/iserv/config-ipv6/accept_ra/$IFACE"

  if [ -n "$IF_ACCEPT_RA" ]
  then
    echo "$IF_ACCEPT_RA" > "$ACCEPT_RA_MARKER_FILE"
  elif [ "$METHOD" = "auto" ] || [ "$METHOD" = "dhcp" ]
  then
    echo 2 > "$ACCEPT_RA_MARKER_FILE"
  elif grep -qx "$IFACE" /var/lib/iserv/config/ipv6-dhcp-interfaces.list
  then
    echo 2 > "$ACCEPT_RA_MARKER_FILE"
  else
    echo 0 > "$ACCEPT_RA_MARKER_FILE"
  fi

  echo -n "Waiting for NIC to be available in /proc/sys... "
  for i in $(seq 1 10000)
  do
    [ -e "/proc/sys/net/ipv6/conf/$IFACE" ] && break
    sleep 0.1
  done
  if [ -e "/proc/sys/net/ipv6/conf/$IFACE" ]
  then
    echo "Done."
  else
    echo "Failed."
  fi

  iconf repair /etc/sysctl.conf || true
  sysctl -p -q || true
fi
