if [ "$PHASE" = "post-up" ] && [ "$ADDRFAM" = "inet6" ]
then
  # Do not wait for dhcpcd here: its start is ordered after the network.
  if [ "$METHOD" = "manual" ] &&
      (grep -qx "$IFACE" /var/lib/iserv/config/ipv6-delegation-interfaces.list ||
      grep -qx "$IFACE" /var/lib/iserv/config/ipv6-dhcp-interfaces.list)
  then
    echo "Scheduling dhcpcd restart ..."
    systemctl --no-block try-restart dhcpcd.service
  fi
fi

