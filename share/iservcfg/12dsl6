#!/bin/bash
set -e

TITLE="DSL IPv6"
DLG=(dialog --stdout --backtitle "IServ-Konfiguration > $TITLE")
CONFIG=/var/lib/iserv/config/ipv6-dsl
DHCPCD_STATE=/var/lib/iserv/config-ipv6/dhcpcd
PEER=/etc/ppp/peers/dsl
DSL_INTERFACE=/usr/lib/iserv/iserv-ipv6-dsl-interface

if [ ! -f "$PEER" ]
then
  "${DLG[@]}" --yesno "DSL ist nicht aktiviert. Aktivieren Sie zuerst die DSL-Einwahl in iservcfg dsl. Soll die DSL-Konfiguration jetzt geöffnet werden?" 0 0 || exit 0
  iservcfg dsl
  if [ ! -f "$PEER" ]
  then
    "${DLG[@]}" --msgbox "DSL ist weiterhin nicht aktiviert. IPv6 für DSL kann erst danach konfiguriert werden." 0 0
    exit 0
  fi
fi

ENABLED=0
ADDRESS_TOKEN=::2
REQUEST_PREFIX=1
REQUEST_NA=1
SLA_LEN=62
REQUEST_NA_SET=0
SLA_LEN_SET=0
if [ -r "$CONFIG" ]
then
  while IFS='=' read -r key value
  do
    case "$key" in
      ENABLED) ENABLED=$value ;;
      ADDRESS_TOKEN) ADDRESS_TOKEN=$value ;;
      REQUEST_PREFIX) REQUEST_PREFIX=$value ;;
      REQUEST_NA) REQUEST_NA=$value; REQUEST_NA_SET=1 ;;
      SLA_LEN) SLA_LEN=$value; SLA_LEN_SET=1 ;;
    esac
  done < "$CONFIG"
fi
if [ "$REQUEST_NA_SET" = 0 ] && [ -r "$DHCPCD_STATE/dsl.request-na" ]
then
  REQUEST_NA=$(cat "$DHCPCD_STATE/dsl.request-na")
fi
if [ "$SLA_LEN_SET" = 0 ] && [ -r "$DHCPCD_STATE/dsl.sla-len" ]
then
  SLA_LEN=$(cat "$DHCPCD_STATE/dsl.sla-len")
fi

value() { [ "$1" = 1 ] && echo aktiviert || echo deaktiviert; }
valid_token() { [[ "$1" =~ ^::[0-9A-Fa-f:]*$ ]]; }
valid_prefix_length() { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -le 128 ]; }

while true
do
  selection=$("${DLG[@]}" --default-item "${selection:-enabled}" \
    --menu "IPv6 für die DSL-Einwahl konfigurieren:" 0 0 0 \
    enabled "IPv6: $(value "$ENABLED")" \
    token "Adress-Token: $ADDRESS_TOKEN" \
    prefix "Präfix anfordern: $(value "$REQUEST_PREFIX")" \
    request_na "IA_NA-Adresse anfordern: $(value "$REQUEST_NA")" \
    sla_len "Delegierte Präfixlänge: /$SLA_LEN" \
    save "Speichern und beenden" \
    exit "Beenden" 2>&1) || exit 0
  case "$selection" in
    enabled)
      ENABLED=$("${DLG[@]}" --menu "IPv6 aktivieren?" 0 0 0 1 "Ja" 0 "Nein" 2>&1) || :
      ;;
    token)
      value=$("${DLG[@]}" --inputbox "IPv6-Adress-Token" 0 0 "$ADDRESS_TOKEN" 2>&1) || continue
      valid_token "$value" || { "${DLG[@]}" --msgbox "Ungültiger IPv6-Adress-Token." 0 0; continue; }
      ADDRESS_TOKEN=$value
      ;;
    prefix)
      REQUEST_PREFIX=$("${DLG[@]}" --menu "Delegiertes IPv6-Präfix anfordern?" 0 0 0 1 "Ja" 0 "Nein" 2>&1) || :
      ;;
    request_na)
      REQUEST_NA=$("${DLG[@]}" --menu "DHCPv6-IA_NA-Adresse anfordern?" 0 0 0 1 "Ja" 0 "Nein" 2>&1) || :
      ;;
    sla_len)
      value=$("${DLG[@]}" --inputbox "Länge des delegierten IPv6-Präfixes (0-128)" 0 0 "$SLA_LEN" 2>&1) || continue
      valid_prefix_length "$value" || { "${DLG[@]}" --msgbox "Ungültige Präfixlänge; erlaubt sind 0 bis 128." 0 0; continue; }
      SLA_LEN=$value
      ;;
    save)
      mkdir -p "$(dirname "$CONFIG")"
      cat > "$CONFIG" <<EOF_CONFIG
ENABLED=$ENABLED
ADDRESS_TOKEN=$ADDRESS_TOKEN
REQUEST_PREFIX=$REQUEST_PREFIX
REQUEST_NA=$REQUEST_NA
SLA_LEN=$SLA_LEN
EOF_CONFIG
      "$DSL_INTERFACE" --apply
      iservchk network dsl dhcpcd
      exit 0
      ;;
    exit) exit 0 ;;
  esac
done
