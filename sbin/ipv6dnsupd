#!/bin/bash
set -e
set -o pipefail

exec 2> >(grep -vE "^dig: couldn't get address for 'ns.iserv.eu': failure$")

run_regdns()
{
  if [ -x "$(which regdns)" ]
  then
    regdns "$@"
  else
    ssh "$(hostname -d)" regdns "$@"
  fi
}

DEFIF="$(. /usr/lib/iserv/ipv6_defif)"


query_status=0
addresses=
if [ -n "$DEFIF" ]; then
  addresses="$(netquery6 -i "$DEFIF" -g "ip")" || query_status=$?
fi
# netquery6 returns 1 for a legitimate empty result; other failures must never
# be interpreted as withdrawal of all addresses.
if [ "$query_status" -gt 1 ]; then
  exit "$query_status"
fi
IPs="$(printf '%s\n' "$addresses" | while read -r i
do
  [ -z "$i" ] && continue
  perl -e 'use Net::IP; print Net::IP::ip_expand_address "'$i'", 6;'
  echo
done | sort)"
  
CURIPs="$(dig +short "$(hostname)" AAAA @ns.iserv.eu | while read i
do
  [ -z "$i" ] && continue
  [ "$i" = ";; connection timed out; no servers could be reached" ] && continue
  perl -e 'use Net::IP; print Net::IP::ip_expand_address "'$i'", 6;'
  echo
done | sort)"

if ! [ "$IPs" = "$CURIPs" ]
then
  run_regdns -d "$(hostname). AAAA"
  for i in ${IPs[@]}
  do
    run_regdns -a "$(hostname). 300 AAAA $i"
  done
fi
