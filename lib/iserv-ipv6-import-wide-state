#!/bin/sh
# Import the WIDE DHCPv6 client identity into dhcpcd state.
set -eu

repair=0
case "${1:-}" in
  '') ;;
  --repair) repair=1 ;;
  *)
    echo "Usage: $0 [--repair]" >&2
    exit 2
    ;;
esac

needs_repair=0

config_dir=${ISERV_IPV6_DHCP_CONFIG_DIR:-/var/lib/iserv/config}
wide_duid_file=${ISERV_IPV6_WIDE_DUID_FILE:-/var/lib/dhcpv6/dhcp6c_duid}
state_dir=${ISERV_IPV6_DHCPCD_STATE_DIR:-/var/lib/iserv/config-ipv6/dhcpcd}


# WIDE stores the DUID as a one-byte length followed by the DUID bytes.  Keep
# this identity while migrating: some access concentrators allow only the
# existing DUID/IAID binding to hold the delegated prefix.
import_wide_duid()
{
  target="$state_dir/duid"
  [ -e "$target" ] && return 0
  [ -r "$wide_duid_file" ] || return 0

  length=$(od -An -tu1 -N1 "$wide_duid_file" | tr -d '[:space:]')
  value=$(dd if="$wide_duid_file" bs=1 skip=1 2>/dev/null | od -An -tx1 -v | tr -d '[:space:]')
  [ -n "$length" ] && [ -n "$value" ] || return 0
  [ "${#value}" -eq "$((length * 2))" ] || return 0

  value=$(printf '%s\n' "$value" | sed 's/../&:/g; s/:$//')
  needs_repair=1
  if [ "$repair" -eq 1 ]
  then
    mkdir -p "$state_dir"
    printf '%s\n' "$value" > "$target"
  fi

  # WIDE's generated configuration always used id-assoc pd 0.  Retaining the
  # IAID makes this a real client-identity migration instead of a new request.
  if [ -r "$config_dir/ipv6-dhcp-interfaces.list" ]
  then
    while IFS= read -r interface
    do
      [ -n "$interface" ] || continue
      target="$state_dir/$interface.iaid"
      if [ ! -e "$target" ]
      then
        needs_repair=1
        [ "$repair" -eq 1 ] && printf '0\n' > "$target"
      fi
    done < "$config_dir/ipv6-dhcp-interfaces.list"
  fi
}

import_wide_duid

if [ "$repair" -eq 1 ]
then
  exit 0
fi
exit "$needs_repair"
